# =============================================================================
# Caddyfile — 个人博客反向代理配置
# Caddy 文档：https://caddyserver.com/docs/caddyfile
# reverse_proxy 指令：https://caddyserver.com/docs/caddyfile/directives/reverse_proxy
#
# 重要：在 Docker 网络中，upstream 地址必须使用「服务名」而非 localhost
# 参考：https://caddyserver.com/docs/running#setup
# =============================================================================

# 全局配置块（作用于所有站点）
{
    # TLS 说明：本站使用 Cloudflare Origin CA 15 年静态证书（见 certs/ 目录）
    # Caddy 不会触发 ACME / Let's Encrypt 流程，也不需要配置 email
    # Cloudflare 侧边缘证书（访客 <-> Cloudflare）由 Universal SSL 自动处理
    # Cloudflare Origin CA 文档：https://developers.cloudflare.com/ssl/origin-configuration/origin-ca/

    # Admin API 默认仅监听 localhost:2019，Docker 内网的 Alloy 无法访问
    # 绑定到 0.0.0.0:2019 使同网络容器可拉取 /metrics 端点
    # ⚠️ 安全：compose.yml 中不暴露 2019 端口到宿主机，仅 Docker 内网可达
    # 参考：https://caddyserver.com/docs/caddyfile/options#admin
    admin 0.0.0.0:2019

    # 开启 HTTP/3（QUIC）—— Caddy 2.11+ 默认已启用，此处为显式声明
    # 同时启用内置 Prometheus Metrics 端点（:2019/metrics），无需额外 exporter
    # 参考：https://caddyserver.com/docs/metrics
    servers {
        protocols h1 h2 h3
        metrics
    }
}

# ── 可复用配置片段（Snippets）─────────────────────────────────────────
# 1. Cloudflare 15 年长效源服务器证书（Full Strict 模式）
(cloudflare_tls) {
    tls /etc/caddy/certs/chonkybird.com.pem /etc/caddy/certs/chonkybird.com.key
}

# 2. 统一访问日志格式（输出到 stderr，由 Alloy 采集推送到 Grafana Loki）
(common_log) {
    log {
        output stderr
        level  INFO
    }
}

# 3. 通用 Web 站点基础配置（TLS 证书 + Gzip/Zstd 压缩 + 访问日志）
(common_site) {
    import cloudflare_tls
    encode gzip zstd
    import common_log
}

# ── 博客前台 ──────────────────────────────────────────────────────────
chonkybird.com, www.chonkybird.com {
    import common_site

    # 将请求反向代理到 frontend 服务（Docker 服务名）的 3000 端口
    reverse_proxy frontend:3000 {
        # 转发真实客户端 IP 到上游（Caddy 默认自动添加 X-Forwarded-For / X-Forwarded-Proto）
        header_up X-Real-IP {remote_host}
    }
}

# ── 管理后台（含 /dozzle* 容器日志代理）──────────────────────────────
admin.chonkybird.com {
    import common_site

    reverse_proxy admin:3000 {
        header_up X-Real-IP {remote_host}
        # 透传 SSE / WebSocket 升级头（保障内嵌 Dozzle 实时日志流与 AI 终端长连接）
        header_up Connection {http.request.header.Connection}
        header_up Upgrade {http.request.header.Upgrade}
    }
}

# ── API 接口 ──────────────────────────────────────────────────────────
api.chonkybird.com {
    import cloudflare_tls
    # API 接口不开启全局压缩（避免影响 AI 问答与 Ops Agent 的 SSE 流式响应缓冲）
    import common_log

    reverse_proxy backend:8080 {
        header_up X-Real-IP {remote_host}
    }
}

# ── 监控中心（Spring Boot Admin，按需启动）──────────────────────────
monitor.chonkybird.com {
    import common_site

    reverse_proxy monitor:9000 {
        header_up X-Real-IP {remote_host}
    }
}

# ── Grafana 监控可视化 ─────────────────────────────────────────────────
# iframe 嵌入需要：GF_SECURITY_ALLOW_EMBEDDING=true（已在 compose.yml 配置）
grafana.chonkybird.com {
    import common_site

    reverse_proxy grafana:3000 {
        header_up X-Real-IP {remote_host}
    }
}

# ── Dozzle 容器日志查看器（安全收敛：禁止公网直连绕过鉴权）───────────
dozzle.chonkybird.com {
    import common_site

    # ⚠️ 安全加固：Dozzle 已启用 DOZZLE_AUTH_PROVIDER=forward-proxy 并挂载在 /dozzle 下，
    # 若直接 reverse_proxy 到 dozzle:8080，外部请求可通过伪造 Remote-User 头绕过后台 JWT 鉴权。
    # 因此将独立子域名永久重定向至管理后台统一入口，强制经过 Admin Middleware 鉴权。
    redir https://admin.chonkybird.com/dozzle permanent
}

# ── Dockge 面板 ───────────────────────────────────────────────────────
dockge.chonkybird.com {
    import common_site

    # Dockge 独立部署在宿主机默认网桥（172.17.0.1:5001），依赖 WebSocket 实时推送状态
    reverse_proxy 172.17.0.1:5001 {
        header_up X-Real-IP {remote_host}
        header_up Connection {http.request.header.Connection}
        header_up Upgrade {http.request.header.Upgrade}
    }
}

# ── CV 简历 ───────────────────────────────────────────────────────────
cv.chonkybird.com {
    import common_site

    # 静态文件服务器，挂载路径见 compose.yml: ./cv:/srv/cv:ro
    root * /srv/cv
    file_server
}

# ── AGY Master 静态站点 ───────────────────────────────────────────────
agy.chonkybird.com {
    import common_site

    # 静态文件目录位于 ./caddy/agy-master-dist（随 ./caddy:/etc/caddy:ro 自动挂载）
    root * /etc/caddy/agy-master-dist
    try_files {path} /index.html
    file_server
}


